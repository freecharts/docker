# Pgpool-II configuration file

# Connection settings
listen_addresses = '*'
port = 5432
socket_dir = '/opt/pgpool/run'

# Backend settings (configure these for your environment)
backend_hostname0 = 'primary-postgresql'
backend_port0 = 5432
backend_weight0 = 1
backend_flag0 = 'ALLOW_TO_FAILOVER'

backend_hostname1 = 'secondary-postgresql'
backend_port1 = 5432
backend_weight1 = 0
backend_flag1 = 'ALLOW_TO_FAILOVER'

# Process management
num_init_children = 32
max_pool = 4
child_life_time = 300
child_max_connections = 0

# Replication mode
streaming_replication_mode = on
replication_mode = off

# Connection pooling
connection_cache = on
pool_conn_dbname = 'template1'
reset_query_list = 'ABORT; DISCARD ALL'

# Health check
health_check_period = 10
health_check_timeout = 20
health_check_user = 'pgpool'
health_check_password = 'pgpool'
health_check_max_retries = 0

# Logging
log_destination = 'stderr'
logging_level = 'info'
log_client_messages = on
log_connections = on
log_disconnections = on

# Load balancing
load_balance_mode = on
black_function_list = ''
